        "measures": [
          {
            "name": "Total Orders",
            "expression": "DISTINCTCOUNT(FactOrders[order_id])",
            "formatString": "#,##0",
            "lineageTag": "61c91b94-adaa-4887-9088-23cee7f7b931"
          },
          {
            "name": "Delivered Orders",
            "expression": "CALCULATE([Total Orders], FactOrders[order_status] = \"delivered\")",
            "formatString": "#,##0",
            "lineageTag": "b2c0cedf-119f-4dd5-9509-479841dfada3"
          },
          {
            "name": "Cancelled Orders",
            "expression": "CALCULATE([Total Orders], FactOrders[order_status] = \"canceled\")",
            "formatString": "#,##0",
            "lineageTag": "8a7d31c3-5298-42a2-9236-5171d0bf3d4c"
          },
          {
            "name": "Delivery Rate",
            "expression": "DIVIDE([Delivered Orders], [Total Orders], 0)",
            "formatString": "0.00%",
            "lineageTag": "822a93e3-c23e-49d9-b97f-cd055c840f42"
          },
          {
            "name": "Cancellation Rate",
            "expression": "DIVIDE([Cancelled Orders], [Total Orders], 0)",
            "formatString": "0.00%",
            "lineageTag": "6fd51d95-e9c2-46ce-871d-97cb910a3847"
          },
          {
            "name": "Average Delivery Days",
            "expression": "CALCULATE(AVERAGE(FactOrders[delivery_days]), FactOrders[order_status] = \"delivered\")",
            "formatString": "0.00",
            "lineageTag": "2bec44d2-980a-45ce-9d3e-85c048696d2e"
          },
          {
            "name": "Median Delivery Days",
            "expression": "CALCULATE(MEDIAN(FactOrders[delivery_days]), FactOrders[order_status] = \"delivered\")",
            "formatString": "0.00",
            "lineageTag": "866ebf14-7fca-43eb-93d3-41f9a5ffea95"
          },
          {
            "name": "Delayed Orders",
            "expression": "CALCULATE([Total Orders], FactOrders[order_status] = \"delivered\", FactOrders[is_delayed] = 1)",
            "formatString": "#,##0",
            "lineageTag": "dc0e6647-5566-4898-a85d-a9bc1236071d"
          },
          {
            "name": "Delay Rate",
            "expression": "DIVIDE([Delayed Orders], [Delivered Orders], 0)",
            "formatString": "0.00%",
            "lineageTag": "da774cdc-0afb-43fa-a615-67c3ea6365d4"
          }
        ],
