        "lineageTag": "1c422562-edc1-45c8-9dcf-9fa9b5c5f8ea",
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM(FactSales[revenue])",
            "formatString": "R$ #,##0.00",
            "lineageTag": "d7122259-abb7-450c-a47d-3834e90cd876"
          },
          {
            "name": "Total Product Sales",
            "expression": "SUM(FactSales[price])",
            "formatString": "R$ #,##0.00",
            "lineageTag": "2732b326-3ccc-41a6-bf71-8dd20a717b98"
          },
          {
            "name": "Total Freight",
            "expression": "SUM(FactSales[freight_value])",
            "formatString": "R$ #,##0.00",
            "lineageTag": "6573bbed-b415-4805-b51f-e946bf031882"
          },
          {
            "name": "Total Items",
            "expression": "COUNTROWS(FactSales)",
            "formatString": "#,##0",
            "lineageTag": "c4ade395-1b83-48af-8e87-bf4e39f5a848"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Total Revenue], [Total Orders], 0)",
            "formatString": "R$ #,##0.00",
            "lineageTag": "527d5599-bfcd-4a87-8e2e-cd69d06f2e84"
          },
          {
            "name": "Average Item Price",
            "expression": "DIVIDE([Total Product Sales], [Total Items], 0)",
            "formatString": "R$ #,##0.00",
            "lineageTag": "680fce0f-84b4-4010-8686-2f19ca070bba"
          },
          {
            "name": "Revenue per Customer",
            "expression": "DIVIDE([Total Revenue], [Total Customers], 0)",
            "formatString": "R$ #,##0.00",
            "lineageTag": "50bf241f-e603-4c6d-a4b0-3c175834e1d9"
          },
          {
            "name": "Customer Revenue",
            "expression": "[Total Revenue]",
            "formatString": "R$ #,##0.00",
            "lineageTag": "23f30185-4ef2-4b73-bc8c-ad8ebad92fcb"
          },
          {
            "name": "Previous Month Revenue",
            "expression": "CALCULATE([Total Revenue], DATEADD(DimDate[date], -1, MONTH))",
            "formatString": "R$ #,##0.00",
            "lineageTag": "1edd1599-d2a5-4b15-bd55-185ab08f7e61"
          },
          {
            "name": "MoM Growth",
            "expression": "VAR CurrentRev = [Total Revenue] VAR PrevRev = [Previous Month Revenue] RETURN IF(NOT ISBLANK(PrevRev) && PrevRev > 0, DIVIDE(CurrentRev - PrevRev, PrevRev, 0), BLANK())",
            "formatString": "0.00%",
            "lineageTag": "ea8a3e1a-7790-43a7-90db-788e2ad186d7"
          },
          {
            "name": "Previous Year Revenue",
            "expression": "CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(DimDate[date]))",
            "formatString": "R$ #,##0.00",
            "lineageTag": "ef4ec7d1-6578-4e66-84b3-4bc0310158a6"
          },
          {
            "name": "YoY Growth",
            "expression": "VAR CurrentRev = [Total Revenue] VAR PrevYearRev = [Previous Year Revenue] RETURN IF(NOT ISBLANK(PrevYearRev) && PrevYearRev > 0, DIVIDE(CurrentRev - PrevYearRev, PrevYearRev, 0), BLANK())",
            "formatString": "0.00%",
            "lineageTag": "e8d1c02e-129f-4848-a490-33488c881a87"
          }
        ],
        "partitions": [
